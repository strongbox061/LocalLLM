# This machine's own settings for the LocalLLM scripts: ~/.config/localllm/local.env (mode 600). Reference listing
# only creates one from this template if run standalone without a backup). It stays out of the repo, so where your backups and passphrase are isn't in it; the settings backup saves

# The file holding the backup passphrase (one line, mode 600). archive-backup.sh and the scheduled backup read it;
# without it, archive-backup.sh asks for the passphrase and the scheduled backup can't run.
# BACKUP_PASSPHRASE_FILE="$HOME/path/to/your/passphrase-file"

# Where archive-backup.sh keeps its encrypted archives (the newest BACKUP_KEEP_COUNT).
# BACKUP_ARCHIVE_DIR="$HOME/path/to/archive-folder"

# Where upload-backup.sh (and the scheduled backup) uploads them: an rclone remote and a folder in it, as
# remote:folder. Create the remote with `rclone config` first.
# BACKUP_REMOTE="your-remote:your-folder"
# How many encrypted archives to keep, in the archive folder and on the remote: the newest ones stay, older ones are
# deleted after each new backup. With the scheduled backup every 6 hours, 8 is about 2 days of PC use.
# BACKUP_KEEP_COUNT="8"

# The model: a profile in the repo's models/ folder (file name without .env); unset, the one named in models/default.
# After changing it: install/llama.sh (downloads it), install/pi.sh, then stop/llama.sh && start/llama.sh.
# MODEL_PROFILE="name-of-a-profile"

# llama-server, tuned to this PC's GPU and CPU (README, "Tuning llama-server"). Each is optional:
# - LLAMA_CUDA_ARCH: the GPU generation install/llama.sh builds for (89 = RTX 40, 86 = RTX 30, 75 = RTX 20,
#   61 = GTX 10); unset, it's read from the GPU (nvidia-smi). A change rebuilds llama.cpp on the next install/llama.sh.
# - LLAMA_N_CPU_MOE: the model's layers whose experts stay on the CPU (out of the profile's MOE_LAYERS); unset, the
#   profile's N_CPU_MOE (33 of 40 for the default profile, which fits an 8 GB GPU). Less VRAM: raise it; more VRAM:
#   lower it. Ignored for models without experts.
# - LLAMA_THREADS: CPU threads; unset, the number of physical cores.
# - LLAMA_CACHE_RAM_MIB: RAM for the prompt cache, in MiB; unset, the profile's CACHE_RAM_MIB.
# - LLAMA_VISION: off leaves the vision projector out (no image input, about 0.9 GB of RAM freed); unset, on.
# After changing them: stop/llama.sh && start/llama.sh.
# LLAMA_CUDA_ARCH="89"
# LLAMA_N_CPU_MOE="33"
# LLAMA_THREADS="8"
# LLAMA_CACHE_RAM_MIB="2048"
# LLAMA_VISION="on"

# GPU limits for long model runs (less heat and fan noise, a little slower), set by services/gpu-limits.sh each
# time llama-server starts. Unset, the GPU's defaults are put back.
# - GPU_MAX_CLOCK_MHZ: caps the GPU's clock; laptop GPUs allow it. Text generation is limited mostly by memory
#   speed, so a cap of about 70% of the GPU's top clock (nvidia-smi -q -d CLOCK, "Max Clocks") costs little speed.
# - GPU_POWER_LIMIT_W: a power limit in watts; most laptop GPUs refuse it (the driver manages their power).
# After changing them: stop/llama.sh && start/llama.sh (a change to the service itself: install/llama.sh).
# GPU_MAX_CLOCK_MHZ="2100"
# GPU_POWER_LIMIT_W="80"

# Pi's subagents (code-finder, web-researcher, planner, worker, reviewer): how many may run at once. 1 (also when unset) runs them one after
# another, the right choice for a PC with one mid-range GPU. More runs them side by side, each in its own llama-server
# slot, so it's capped at the profile's SLOTS (and each one shares the GPU). After changing it: install/pi-config.sh
# (writes model.json), then restart Pi.
# SUBAGENTS_AT_ONCE="1"
# The most subagents one message of yours may start, in all (8 when unset). The model is told the limit when it asks
# for more. Not capped at the slots: past SUBAGENTS_AT_ONCE they wait their turn.
# SUBAGENTS_MAX="4"


