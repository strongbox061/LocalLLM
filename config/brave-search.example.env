# Brave Search API Configuration
#
# Standalone Brave Search API key template for LocalLLM.
# Get your API key at https://brave.com/search/api/
#
# Usage: source this file or export BRAVE_SEARCH_API_KEY directly.

# Brave Search API key (required for web search queries)
BRAVE_SEARCH_API_KEY=

# Search endpoint (default; usually no need to change)
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Default number of results per query (1-50)
BRAVE_SEARCH_RESULTS=10

# Language code for search results (ISO 639-1, e.g. en, fr, de)
BRAVE_SEARCH_LANG=en

# Region code for search results (ISO 3166-1 alpha-2, e.g. us, uk, ca)
BRAVE_SEARCH_REGION=us

# Validate API key before use (returns JSON with "QueryError" on failure)
# echo "$BRAVE_SEARCH_API_KEY" | grep -qE '^[A-Za-z0-9]{32}$' || echo "Invalid Brave API key format"
