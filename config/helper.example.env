# The helper PC's own values (two-PC setup; README, "Two-PC setup"): ~/.config/localllm/helper.env on the MAIN PC
# (mode 600, in the settings backup). The helper never reads it: ./localllm.sh install-helper and deploy send what it
# needs. ./localllm.sh install-helper makes this file from the template when it doesn't exist yet.

# Where the helper stores large files: Python envs, models, Open WebUI data.
# Leave unset and install-helper picks the internal NTFS drive with the most free space.
# HELPER_DATA_DIR="X:\LocalLLM"

# Optional helper features (enabled when unset).
# HELPER_SMALL_MODEL="on"   # small model for chat titles, tags, follow-ups in Open WebUI
# HELPER_IMAGES="on"        # ComfyUI + Stable Diffusion 1.5 for image generation
# HELPER_DOCLING="on"       # Docling for PDF/OCR document reading

# Kokoro TTS: run on the helper's gpu or fall back to cpu.
# HELPER_KOKORO_DEVICE="gpu"
