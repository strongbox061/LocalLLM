{
  "filesystem": {
    "allowRead": [
      "~/.pi/agent/sessions/**/.pi-agent-browser-artifacts/**",
      "~/.pi/agent/skills/**"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "~/.ssh",
      "~/.gnupg",
      "~/.pi",
      "~/.config",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.profile"
    ]
  }
}
