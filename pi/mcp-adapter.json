{
  "settings": {
    "namespaceProxyTools": false,
    "allowInstall": false,
    "allowScriptToolSave": false,
    "notifyOnStartupConnect": false,
    "disableProxyTool": true,
    "oauthCredentialStore": "encrypted-file"
  },
  "mcpServers": {
    "gitmcp": {
      "url": "https://gitmcp.io/docs",
      "description": "Live docs of any GitHub project (llms.txt, README, docs folder), read when asked",
      "includeTools": [
        "match_common_libs_owner_repo_mapping",
        "fetch_generic_documentation",
        "search_generic_documentation"
      ],
      "directTools": true
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp/oauth",
      "auth": "oauth",
      "protocolVersion": "auto",
      "description": "Indexed library docs for a specific version",
      "directTools": true
    }
  },
  "toolGroups": {
    "context7": ["docs", "gitmcp", "web-search"]
  },
  "defaults": {
    "maxToolCalls": 10,
    "timeoutMs": 30000,
    "retryOnFailure": true,
    "maxRetries": 2
  }
}
