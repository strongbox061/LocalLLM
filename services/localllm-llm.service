[Unit]
Description=llama.cpp server - the local model (profile: MODEL_PROFILE in ~/.config/localllm/local.env)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
# GPU_MAX_CLOCK_MHZ / GPU_POWER_LIMIT_W from local.env, as root ("+"); it never blocks the start.
ExecStartPre=+@REPO_DIR@/services/gpu-limits.sh @USER@
ExecStart=@REPO_DIR@/services/llm-server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
