# Encrypted backup of backup/ to the rclone remote. Started by localllm-backup.timer.
# install/backup-timer.sh fills in @REPO_DIR@ and installs it as ~/.config/systemd/user/localllm-backup.service.

[Unit]
Description=LocalLLM encrypted off-site backup
After=network-online.target

[Service]
Type=oneshot
ExecStart=@REPO_DIR@/upload-backup.sh
