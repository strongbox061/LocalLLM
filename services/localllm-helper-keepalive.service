# Keep Tailscale connection to helper PC alive for SSH.
# Install with: sudo cp localllm-helper-keepalive.service ~/.config/systemd/user/
# Then run: systemctl --user enable --now localllm-helper-keepalive.service

[Unit]
Description=LocalLLM helper PC Tailscale keepalive ping

[Service]
Type=oneshot
SuccessExitStatus=0 1
ExecStart=/usr/bin/tailscale ping -c 1 --timeout 5s @HELPER_HOST@
