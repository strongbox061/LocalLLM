# Keeps Tailscale's direct WireGuard path to the helper PC warm so SSH doesn't time out after idle periods.
# install/helper-keepalive.sh fills in @HELPER_HOST@ and installs it as ~/.config/systemd/user/localllm-helper-keepalive.service.

[Unit]
Description=LocalLLM helper PC Tailscale keepalive ping

[Service]
Type=oneshot
ExecStart=/usr/bin/tailscale ping -n -c 1 --timeout 5s @HELPER_HOST@
