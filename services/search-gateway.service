# The search gateway (services/search_gateway.py) on 127.0.0.1:8090: every web search of Pi and Open WebUI, the usage
# dashboard (/dashboard) and the settings page (/settings). Runs in its own Python environment; doesn't need Open WebUI.
# install/search-gateway.sh fills in @PYTHON@ (that environment's Python) and @REPO_DIR@ and installs it as
# ~/.config/systemd/user/search-gateway.service. Not enabled: start.sh starts it.

[Unit]
Description=Search gateway: web search for Pi and Open WebUI, its usage dashboard and settings page

[Service]
ExecStart=@PYTHON@ @REPO_DIR@/services/search_gateway.py
Environment=SEARCH_GATEWAY_PORT=8090
Environment=SEARCH_GATEWAY_DEBUG=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
