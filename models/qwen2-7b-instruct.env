# Qwen2-7B-Instruct profile — fits in 8 GB VRAM
MODEL_NAME="Qwen2-7B-Instruct"
MODEL_PATH="./models/Qwen2-7B-Instruct-GGUF/qwen2-7b-instruct-q4_k_m.gguf"
MODEL_FORMAT="gguf"

# Inference engine
ENGINE="llama.cpp"
LLAMA_CPP_BIN="./bin/llama-server"

# GPU offload — max layers for 8 GB VRAM
GPU_LAYERS=33
CUDA_DEVICES=0

# Context and batching
CONTEXT_LENGTH=4096
BATCH_SIZE=512
THREADS=8

# Quantization
QUANTIZATION="Q4_K_M"
QUANT_VERSION="q4_k_m"

# Temperature and sampling
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1
REPEAT_PENALTY_RANGE=128
FREQUENCY_PENALTY=0.0
STREAMING=true

# System prompt defaults
SYSTEM_PROMPT="You are a helpful assistant."
MAX_TOKENS=2048

# Performance tuning
MLOCK=false
MMAP=true
CACHE_TYPE_K="f16"
CACHE_TYPE_V="f16"
ROPE_SCALING="linear"
ROPE_SCALE_FACTOR=1.0
