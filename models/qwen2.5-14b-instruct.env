# Qwen2.5-14B-Instruct — Coder profile
# Optimized for code generation with partial GPU/CPU offload

MODEL_NAME="Qwen2.5-14B-Instruct"
MODEL_PATH="./models/Qwen2.5-14B-Instruct-Q4_K_M.gguf"
MODEL_FORMAT="gguf"

# Server settings
LLM_HOST="0.0.0.0"
LLM_PORT=8080
LLM_BACKEND="llama.cpp"
LLM_API="openai-compat"

# Context & generation
CONTEXT_SIZE=8192
NUM_PREDICT=-1
TEMPERATURE=0.7
TOP_P=0.92
TOP_K=40
STOP_SEQUENCE="<|im_end|>"

# GPU offload (partial — fit remaining layers on CPU)
GPU_LAYERS=35
TOTAL_LAYERS=48
MEMORY_STRATEGY="pinned"

# Performance
NUM_THREADS=8
NUM_BATCHES=256
MLOCK=false

# Logging
LOG_LEVEL="info"
LOG_FILE="./logs/qwen-14b.log"
