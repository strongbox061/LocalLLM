# Llama-2-7B-Chat model profile
# Meta AI | Released Jul 18, 2023 | GGML q4_0 quantization

MODEL_NAME="Llama-2-7B-Chat"
MODEL_FILE="llama-2-7b-chat.ggml.q4_0.bin"
MODEL_REPOSITORY="TheBloke/Llama-2-7B-Chat-GGML"
MODEL_QUANTIZATION="q4_0"
MODEL_FORMAT="ggml"

# Download URL (TheBloke mirror on Hugging Face)
MODEL_URL="https://huggingface.co/TheBloke/Llama-2-7B-Chat-GGML/resolve/main/llama-2-7b-chat.ggml.q4_0.bin"

# Inference settings
LLAMA_CONTEXT_SIZE=512
LLAMA_BATCH_SIZE=512
LLAMA_THREADS=4
LLAMA_NUM_KEEP_ALIVE=5
LLAMA_TEMP=0.7
LLAMA_TOP_P=0.9
LLAMA_REPEAT_PENALTY=1.1

# System prompt for chat mode
SYSTEM_PROMPT="[INST] <<SYS>>\nYou are a helpful, respectful and honest assistant. Always answer as helpfully as possible, while being safe. Your answers should not include any harmful, unethical, racist, sexist, toxic, dangerous, or illegal content. Please ensure that your responses are socially unbiased and positive in nature.\n<</SYS>>\n\n"

# Token limits
MAX_TOKENS=256
MIN_TOKENS=1
STOP_TOKENS="[/INST]"

# Hardware notes
RECOMMENDED_RAM_GB=8
RECOMMENDED_VRAM_GB=4
SUPPORTED_OS="linux,darwin,windows"
