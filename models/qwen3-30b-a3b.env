# Qwen3-30B-A3B MoE — CPU expert offload profile
# First Qwen MoE with thinking mode; no vision mmproj support

MODEL_NAME=qwen3-30b-a3b
MODEL_PATH=/opt/models/qwen3-30b-a3b
MODEL_FORMAT=gguf

# MoE expert routing — offload non-active experts to CPU RAM
EXPERT_OFFLOAD=true
GPU_LAYERS=40
CPU_EXPERT_BATCH=8
EXPERT_MEMORY_THRESHOLD=12

# Thinking mode (chain-of-thought)
THINKING_ENABLED=true
THINKING_MAX_TOKENS=2048
THINKING_MIN_TOKENS=128

# Quantization — 4-bit for CPU offload friendliness
QUANTIZATION=Q4_K_M
NUMA_OPTIMIZED=true

# Inference settings
CONTEXT_LENGTH=32768
NUM_WORKERS=4
THREAD_COUNT=16
BATCH_SIZE=512

# Memory management
CACHE_TYPE=llama
CACHE_SIZE_MB=2048
SWAP_THRESHOLD_GB=4

# Logging
LOG_LEVEL=info
METRICS_ENABLED=true
