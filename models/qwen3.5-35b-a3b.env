# Qwen3.5-35B-A3B MoE + mmproj vision profile
# Active LLM Era: Qwen3.6-35B-A3B (UD-Q4_K_XL + mmproj-F16)

MODEL_NAME=qwen3.5-35b-a3b
MODEL_PATH=models/Qwen3.5-35B-A3B-Q4_K_XL.gguf
VLM_PROJECTOR_PATH=models/Qwen3.5-35B-A3B-mmproj-f16.gguf

# Quantization
QUANTIZATION=UD-Q4_K_XL
EXPERT_OFFLOAD=cpu
SHARED_EXPERTS=false

# MoE settings
MOE_ENABLED=true
NUM_EXPERTS=4
ACTIVE_EXPERTS=1
FFN_MODE=parallel

# Inference
CONTEXT_LENGTH=32768
BATCH_SIZE=2048
THREADS=8
AFFINITY=hyperthread
PREFILL_BATCH=512

# Vision
VISION_EMBEDDING_DIM=3584
VISION_CHUNK_SIZE=256
VISION_FUSION=linear

# Sampling
TEMPERATURE=0.7
TOP_P=0.92
TOP_K=50
REPEAT_PENALTY=1.1
REPEAT_PENALTY_RANGE=512

# Performance
GPU_LAYERS=35
CPU_THREADS=8
MEMORY_FRACTION=0.85
KV_CACHE_TYPE=f16
