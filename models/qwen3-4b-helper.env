# Qwen3-4B-Instruct-2507 helper profile
# Lightweight assistant for quick completions and formatting tasks

# Model
MODEL_NAME="qwen3-4b-instruct-2507"
MODEL_PATH="${LLM_MODELS_DIR}/qwen3-4b-instruct-2507.Q4_K_M.gguf"

# Inference
LLM_PORT=12341
LLM_CTX_LEN=4096
LLM_BATCH_SIZE=512
LLM_THREADS=4
LLM_TEMP=0.5
LLM_TOP_P=0.9
LLM_STOP="\n\nuser:\n"

# CPU offload (MoE expert routing)
LLM_MLOCK=true
LLM_GPU_LAYERS=0
LLM_MMAP=true

# System prompt
HELPER_PROMPT="You are a helpful assistant running on CPU. Keep responses concise and accurate."
