# Qwen-7B-Chat GGUF profile for 8 GB VRAM
# Released by Alibaba (June 2023), quantized via llama.cpp

MODEL_NAME="Qwen-7B-Chat"
MODEL_FILE="qwen-7b-chat.Q4_K_M.gguf"
MODEL_URL="https://huggingface.co/bartowski/Qwen-7B-Chat-GGUF/resolve/main/Qwen-7B-Chat.Q4_K_M.gguf"

# Quantization: Q4_K_M balances quality and size (~4.9 GB)
QUANTIZATION="Q4_K_M"

# Approximate model size for disk planning
MODEL_SIZE_GB=4.9

# Local download path (relative to repo root)
DOWNLOAD_PATH="models/${MODEL_FILE}"

# Context length
CONTEXT_LENGTH=2048

# GPU offload layers (8 GB VRAM — reserve ~1.5 GB for KV cache at 2k context)
GPU_LAYERS=32

# Inference parameters
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.05

# llama.cpp flags
LLAMA_FLAGS="--ctx-size ${CONTEXT_LENGTH} --n-gpu-layers ${GPU_LAYERS} --top-p ${TOP_P} --repeat-penalty ${REPETITION_PENALTY}"
