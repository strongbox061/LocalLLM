# models/vicuna-7b-ggml.env — Vicuna-7B chat profile (GGML q4_0)
# Source this file to override the default LLaMA-7B settings with a fine-tuned
# conversational model trained on ShareGPT data by lmsys.org.
#
#   source models/vicuna-7b-ggml.env
#   ./run-ggml.sh
#

# Path to the GGML q4_0 model file (downloaded from the lmsys GitHub releases).
VICUNA_MODEL_PATH="${VICUNA_MODEL_PATH:-$HOME/LocalLLM/models/vicuna-7b-1.1.ggmlv3.q4_0.bin}"

# Vicuna-7B uses a 2k context window; bump it if VRAM allows (max ~4096 on 8 GB).
CONTEXT_SIZE="${CONTEXT_SIZE:-2048}"

# Temperature: 0.7 gives a good balance of creativity and coherence for chat.
TEMPERATURE="${TEMPERATURE:-0.7}"

# Number of tokens to generate in a single pass.
GENERATION_LENGTH="${GENERATION_LENGTH:-512}"

# Batch size — larger is faster but uses more RAM; 512 is the default in llama.cpp.
BATCH_SIZE="${BATCH_SIZE:-512}"

# Threads: set to your core count (e.g. 8 on a 6700X). Defaults to physical cores.
THREADS="${THREADS:-$(nproc)}"

# Prompt template for Vicuna v1.1 — matches the instruction-response format.
PROMPT_TEMPLATE="${PROMPT_TEMPLATE:-A chat between a curious user and an artificial intelligence assistant. The assistant gives helpful, detailed, and polite answers to the user's questions. USER: {prompt} ASSISTANT:}"

# Repeat penalty — penalizes token repetition; 1.0 disables it.
REPEAT_PENALTY="${REPEAT_PENALTY:-1.1}"

# Number of recent tokens to consider for repeat penalty.
REPEAT_LAST_N="${REPEAT_LAST_N:-64}"

# Seed for reproducibility; -1 uses random seed.
SEED="${SEED:--1}"
