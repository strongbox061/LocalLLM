# LLaMA-7B GGML q4_0 profile — llama.cpp main binary (2023-03-14)
# Early inference settings for 4-bit quantized LLaMA-7B model

MODEL_PATH=models/llama-7b-ggml.bin
MODEL_QUANT=q4_0
CONTEXT_SIZE=512
NUM_THREADS=4
BATCH_SIZE=512
KEEP_MEMORY=1
FLASH_ATTN=0
MLOCK=0
MMAP=1

# Sampling parameters
TEMPERATURE=0.7
TOP_P=0.9
REPEAT_PENALTY=1.1
REPEAT_LAST_N=64
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0

# Generation limits
MAX_TOKENS=256
SEED=-1

# Prompt template (Vicuna-7B style)
PROMPT_TEMPLATE="USER: {prompt}\nASSISTANT:"
