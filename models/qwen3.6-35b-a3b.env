# Model profile: Qwen3.6 35B-A3B (mixture of experts, 3B active), 4-bit, with image input. The default profile.
# A profile describes the model only; what depends on the PC (GPU architecture, threads, the CPU/GPU split) is in
# ~/.config/localllm/local.env, which wins. Choose a profile there with MODEL_PROFILE=<file name without .env>.
# Read by lib/model.sh (bash): install/llama.sh, services/llm-server.sh, install/pi.sh, services/open-webui.sh.

# Shown in Pi's model list and in messages. Pi and Open WebUI always ask llama-server for the alias "local".
MODEL_NAME="Qwen3.6 35B-A3B"

# Hugging Face repository and the file to download into ~/LocalLLM/models.
MODEL_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf"

# The vision projector (image input): its file in MODEL_REPO and the name it is saved under (the repo's name is
# generic). Leave both empty for a model without image input.
MMPROJ_FILE="mmproj-F16.gguf"
MMPROJ_LOCAL="Qwen3.6-35B-A3B-mmproj-F16.gguf"

# Context: SLOTS conversations at once (Pi in slot 0, Open WebUI in slot 1), CTX_PER_SLOT tokens each. MAX_TOKENS is
# the longest answer; Pi's context window is CTX_PER_SLOT - MAX_TOKENS.
CTX_PER_SLOT=65536
SLOTS=2
