# Llama-2-13B-GGUF partial-offload experiment
# Meta AI | Released Jul 18, 2023 | GGUF q4_0 quantization

MODEL_NAME="Llama-2-13B-Chat"
MODEL_FILE="llama-2-13b-chat.Q4_K_M.gguf"
MODEL_REPOSITORY="TheBloke/Llama-2-13B-Chat-GGUF"
MODEL_QUANTIZATION="Q4_K_M"
MODEL_FORMAT="gguf"

# Download URL (TheBloke mirror on Hugging Face)
MODEL_URL="https://huggingface.co/TheBloke/Llama-2-13B-Chat-GGUF/resolve/main/llama-2-13b-chat.Q4_K_M.gguf"

# Inference settings
LLAMA_CONTEXT_SIZE=4096
LLAMA_BATCH_SIZE=512
LLAMA_THREADS=4
LLAMA_NUM_KEEP_ALIVE=5
LLAMA_TEMP=0.7
LLAMA_TOP_P=0.9
LLAMA_REPEAT_PENALTY=1.1

# Partial GPU offload (13B needs ~8GB VRAM for full, split across layers)
LLAMA_GPU_LAYERS=20
LLAMA_MAIN_GPU=0

# System prompt for chat mode
SYSTEM_PROMPT="[INST] <<SYS>>\nYou are a helpful, respectful and honest assistant. Always answer as helpfully as possible, while being safe. Your answers should not include any harmful, unethical, racist, sexist, toxic, dangerous, or illegal content. Please ensure that your responses are socially unbiased and positive in nature.\n<</SYS>>\n\n"

# Token limits
MAX_TOKENS=512
MIN_TOKENS=1
STOP_TOKENS="[/INST]"

# Hardware notes
RECOMMENDED_RAM_GB=16
RECOMMENDED_VRAM_GB=8
SUPPORTED_OS="linux,darwin,windows"
